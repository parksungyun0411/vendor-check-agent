# 공공데이터포털 인증키 (국세청 15081808, 금융위 15043184 활용신청). URL 인코딩하지 않은 키를 넣는다(Encoding·Decoding 두 가지가 보이면 Decoding 키).
DATA_GO_KR_SERVICE_KEY=
# OpenDART 인증키 (40자리)
OPENDART_API_KEY=

# 보고서 작성 LLM: stub(기본, 토큰 0) | anthropic
LLM_PROVIDER=stub
LLM_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=
# 건당 비용 계산용 단가(USD / 100만 토큰). 요금표를 보고 직접 넣는다. 비우면 비용 칸이 빈다.
LLM_PRICE_INPUT_PER_MTOK=
LLM_PRICE_OUTPUT_PER_MTOK=

# strict(본문까지 검사) | lenient(HTTP 상태만 확인)
DETECTION_MODE=strict
TOOL_TIMEOUT_S=10

# 실패 주입 프록시를 따로 띄워 MCP 서버를 그 뒤에 둘 때만 바꾼다
# NTS_BASE_URL=http://127.0.0.1:8787/nts
# FSC_BASE_URL=http://127.0.0.1:8787/fsc
# DART_BASE_URL=http://127.0.0.1:8787/dart
STATE_DIR=.state
